    {
      "name": "8. Pruebas de Seguridad",
      "item": [
        {
          "name": "401 - Sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/emprendimientos", "host": ["{{baseUrl}}"], "path": ["api","emprendimientos"] }
