{
  "info": {
    "name": "Taller 4 — Emprendimientos API",
    "description": "Colección REST API con JWT — Computación en Internet II",
    "_postman_id": "taller4-emprendimientos-2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",           "value": "http://localhost:8081" },
    { "key": "token",             "value": "" },
    { "key": "userId",            "value": "" },
    { "key": "categoriaId",       "value": "" },
    { "key": "emprendimientoId",  "value": "" },
    { "key": "productoId",        "value": "" },
    { "key": "pedidoId",          "value": "" },
    { "key": "rolId",             "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreCompleto\": \"Test User\",\n  \"correoInstitucional\": \"testuser@icesi.edu.co\",\n  \"programaAcademico\": \"Ingenieria de Sistemas\",\n  \"semestreAcademico\": 5,\n  \"clave\": \"test1234\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "pm.environment.set('userId', json.idUsuario);"] } }]
        },
        {
          "name": "Login (obtener token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correoInstitucional\": \"ximena@icesi.edu.co\",\n  \"clave\": \"1234\"\n}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["var json = pm.response.json();", "pm.environment.set('token', json.token);", "pm.test('Token recibido', function(){ pm.expect(json.token).to.not.be.empty; });"] } }]
        },
        {
          "name": "Login como Comprador (juan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correoInstitucional\": \"juan@icesi.edu.co\",\n  \"clave\": \"1234\"\n}"
            }
          }
        }
      ]
    },
    {
